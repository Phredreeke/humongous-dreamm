desc[he-spyfoxmustard]:

name = Spy Fox in Hold The Mustard
icon = he-spyfoxmustard.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\mustard.exe"
osenv = windows 98
audiohw = gmidi
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


//
// 1999 version (Super Arcade 2)
//
game[pc-en-990822]:
