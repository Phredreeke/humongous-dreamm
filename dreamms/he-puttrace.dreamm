desc[he-puttrace]:

name = Putt-Putt Enters the Race
icon = he-puttrace.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\PUTTRACE.EXE"
osenv = windows 98
winres = 640x480x8


//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// Windows version
//
BITNESS = false
config[bitness]:
    condition = $(BITNESS)
    title = Windows version
    option[win311]:   name = Windows 3.11; osenv= windows 3.11.002
    option[win98]: name = Windows 98; priority = 1
end

//
// 1998 version
//
game[pc-en-981008]:
    name = English 1998-10-08
    anchorfile = PUTTRACE.EXE
    BITNESS = true
    file[]: crc = 7fab0f20; size =       672; name = COPYRITE.TXT; optional = true
