    name = English 2000-03-17
    imports = pc-en-971214
    anchorfile = FREDDI3.EXE
    file[]: crc = bccf8d52; size =       678; name = COPYRITE.TXT  // new file
    file[]: crc = 8b50bf67; size =     81920; name = FREDDI3.EXE  // replaces ee48f171/21616
