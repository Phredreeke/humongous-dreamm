desc[he-activity]:

name = Putt-Putt & Fatty Bear's Activity Pack
icon = he-activity.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\ACTIVITY.EXE"
osenv = windows 98
winres = 640x480x8
INIPATH = C:\ACTIVITY\ACTIVITY.INI

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


//
// Block ALT key
//
script[remap]:
    condition = $(DOSAUDIO)
    code = [[[$(CRLF)
       keyboard_install_hook(0x38, "remap");
       func remap() {  }
    ]]]
end

//
// Windows version
//
BITNESS = true
config[bitness]:
    condition = $(BITNESS)
    title = Windows version
    option[win311]:   name = Windows 3.11; osenv= windows 3.11.002
    option[win98]: name = Windows 98; priority = 1
end

//
// Set up INI file for DOS version
//
DOSAUDIO = false

INIDATA = [[[$(CRLF)
DigitalSoundDriver=sblaster.com
MidiSoundDriver=sbfm.adv
MidiType=0
IOAddress=220
IRQ=7
]]]

script[init]:
    code = [[[$(CRLF)
    if (is_windows())
    {    
    file_create("C:\\WINDOWS\\SYSTEM\\WING32.DLL");
    }
    if (DOSAUDIO = true)
    {    
    file_save("$$(INIPATH)", "$$(INIDATA)");
    }
    ]]]
end


//
// 1993 Putt-Putt's Fun Pack DOS version 
//
game[pc-en-930301-ppfp]:
    name = Putt-Putt's Fun Pack English DOS 1993-03-01
    anchorfile = FUNPACK.EXE
    osenv = dos
    fixdivover = true
    mips = $(MIPS_386DX_33)
    ramkb = 16384
    audiohw = adlib+sb16
    videohw = svga
    DOSAUDIO = true
    BITNESS = false
    INIPATH = C:\FUNPACK\FUNPACK.INI
    launch = "$(rootpath)\FUNPACK.EXE" 
    file[]: crc = d9c83981; size =      5217; name = CHECK.EXE
    file[]: crc = a9c9ca05; size =    111964; name = FUNPACK.DRV
    file[]: crc = 658f9780; size =    128779; name = FUNPACK.EXE
    file[]: crc = 4e7c3215; size =      5798; name = FUNPACK.HE0
    file[]: crc = 6e375151; size =    860415; name = FUNPACK.HE1
    file[]: crc = 1cc08fcf; size =       766; name = FUNPACK.ICO; optional = true
    file[]: crc = 8a0889a6; size =       182; name = FUNPACK.INI; optional = true
    file[]: crc = b4e3ee66; size =       545; name = FUNPACK.PIF; optional = true
    file[]: crc = 2ae33e01; size =   1818654; name = FUNPACK.TLK
    file[]: crc = 34e73a06; size =    124508; name = SETUPCD.EXE; optional = true


end

