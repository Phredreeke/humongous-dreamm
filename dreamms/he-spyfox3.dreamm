desc[he-spyfox3]:

name = SPY Fox 3: Operation Ozone
icon = he-spyfox3.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\spyozon.exe"
osenv = windows 98
audiohw = gmidi
winres = 640x480x16

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


//
// 2001 version
//
