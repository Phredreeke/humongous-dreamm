desc[he-bybasket]:

name = Backyard Basketball
icon = he-bybasket.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\Basketball.exe"
osenv = windows 98
winres = 640x480x16

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


//
// 2001 version
//
game[pc-en-010921]:
    name = English 2001-09-21
    anchordepth = 1
    anchorfile = Basketball.exe
