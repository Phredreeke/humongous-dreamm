desc[he-bluesread]:

name = Blue's Reading Time Activities
icon = he-bluesread.png
machine = pc
rootpath = C:\
launch = "C:\Blue's Reading Time.exe"
osenv = windows 98
winres = 640x480x16

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

