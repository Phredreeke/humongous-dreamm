desc[he-bluesabc]:

name = Blue's ABC Time Activities
icon = he-bluesabc.png
machine = pc
rootpath = C:\
launch = $(rootpath)\BluesABCTime.exe
osenv = windows 98
winres = 640x480x16

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

