desc[he-gaspocket]:

name = A Gaspocket Adventure: Aliens Ate My Cookies
icon = he-gaspocket.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\gaspocketdemo.exe"
osenv = windows 98
audiohw = gmidi
winres = 640x480x16

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


//
// 2001 Prototype
//

game[pc-en-010503]:
