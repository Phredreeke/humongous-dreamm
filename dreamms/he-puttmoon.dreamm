desc[he-puttmoon]:

name = Putt-Putt Goes to the Moon
icon = he-puttmoon.png
machine = pc
rootpath = C:\PUTTMOON
launch = "$(rootpath)\PUTTMOON.EXE"
osenv = windows 98
INIPATH = C:\PUTTMOON\PUTTMOON.INI
DIGI_DRIVER = $(NULL)
MIDI_DRIVER = $(NULL)
IO = $(NULL)
IRQ = $(NULL)
DIGI_ID = $(NULL)

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

config[sound]:
    condition = is_dos()
    title = Sound Configuration
    option[speaker-music]: name = $(SPEAKER_NAME) (Music); MIDI_DRIVER = pcspkr.adv
    option[speaker-voice]: name = $(SPEAKER_NAME) (Speech); DIGI_DRIVER = ibmbak.com; DIGI_ID = 1
    option[adlib-music]:   name = $(ADLIB_NAME) (Music); MIDI_DRIVER = adlib.adv
    option[adlib-voice]:   name = $(ADLIB_NAME) (Speech); DIGI_DRIVER = adlib.com; DIGI_ID = 1
    option[sb16]:          name = $(SB16_NAME); DIGI_DRIVER = sblaster.com; MIDI_DRIVER = sbfm.adv; IO=220; IRQ=7; priority = 1
end

//
// Set up INI file for DOS version
//
INIDATA = [[[$(CRLF)
    DigitalSoundDriver=$(DIGI_DRIVER)
    MidiSoundDriver=$(MIDI_DRIVER)
    IOAddress=$(IO)
    IRQ=$(IRQ)
    DigitalID=$(DIGI_ID)
    MidiInstFile=fat.ad
]]]

script[init]:
    condition = is_dos() && !is_installer()
    code = [[[$(CRLF)
        // Block ALT key
       keyboard_install_hook(0x38, "remap");
       func remap(){}

       // Save config INI
       file_save("$$(INIPATH)", "$$(INIDATA)");
    ]]]
end

script[autoinstall]:
    condition = is_installer() && is_dos()
    code = [[[$(CRLF)
        if (!prop("noautoinstall")) {
            input_lockout(true);
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
        }
    ]]]
end

fragment[dos-stub]:
    osenv = dos
    fixdivover = true
    mips = $(MIPS_386DX_33)
    ramkb = 16384
    audiohw = adlib+sb16
    videohw = svga
    rootpath = C:\PUTTMOON\
end

