    file[]: crc = c1c1c5a1; size =       545; name = PUTTMOON.PIF; optional = true
    file[]: crc = 8d8727f9; size =  11293948; name = PUTTMOON.TLK
    file[]: name = SETUPCD.EXE; optional = true


end


