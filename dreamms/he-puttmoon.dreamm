desc[he-puttmoon]:

name = Putt-Putt Goes to the Moon
icon = he-puttmoon.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\PUTTMOON.EXE"
osenv = windows 98
DOSAUDIO = false
INIPATH = C:\PUTTMOON\PUTTMOON.INI

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


//
// Windows version
//
BITNESS = true
config[bitness]:
    condition = $(BITNESS)
    title = Windows version
    option[win311]:   name = Windows 3.11; osenv= windows 3.11.002
    option[win98]: name = Windows 98; priority = 1
end

//
// Block ALT key
//
script[remap]:
    condition = $(DOSAUDIO)
    code = [[[$(CRLF)
       keyboard_install_hook(0x38, "remap");
       func remap() {  }
    ]]]
end

//
// Set up INI file for DOS version
//
INIDATA = [[[$(CRLF)
DigitalSoundDriver=sblaster.com
MidiSoundDriver=sbfm.adv
IOAddress=220
IRQ=7
DigitalID=
MidiInstFile=fat.ad
]]]

script[init]:
    code = [[[$(CRLF)
    if (is_windows())
    {    
    file_create("C:\\WINDOWS\\SYSTEM\\WING32.DLL");
    }
    if (DOSAUDIO = true)
    {    
    file_save("$$(INIPATH)", "$$(INIDATA)");
    }
    ]]]
end

//
// 1994 DOS version
//
game[pc-en-940118]:
    name = English 1993-11-04
    anchorfile = PUTTMOON.EXE
    osenv = dos
    fixdivover = true
    mips = $(MIPS_386DX_33)
    ramkb = 16384
    audiohw = adlib+sb16
    videohw = svga
    DOSAUDIO = true
    BITNESS = false
    file[]: crc = 56d59cb8; size =      7737; name = CHECK.EXE
    file[]: crc = d402deda; size =     45564; name = PUTTMOON.BRS
    file[]: crc = 3e59a339; size =    197900; name = PUTTMOON.DRV
    file[]: crc = fba38c66; size =    142807; name = PUTTMOON.EXE
    file[]: crc = e56edf6f; size =      7863; name = PUTTMOON.HE0
