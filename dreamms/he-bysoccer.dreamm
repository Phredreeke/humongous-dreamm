desc[he-bysoccer]:

name = Backyard Soccer
icon = he-bysoccer.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\SOCCER.EXE"
osenv = windows 98
audiohw = gmidi
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// Windows version
//
config[bitness]:
    title = Windows version
    option[win311]:   name = Windows 3.11; osenv= windows 3.11.002
    option[win98]: name = Windows 98; priority = 1
end

//
// 1998 version
//
game[pc-en-980901]:
    name = English 1998-09-01
    anchorfile = SOCCER.EXE
    file[]: crc = 7fab0f20; size =       672; name = COPYRITE.TXT; optional = true
    file[]: crc = abb96326; size =    308278; name = HE.BMP; optional = true
    file[]: crc = e2e2de14; size =     14912; name = HEINI.EXE; optional = true
    file[]: crc = b76e98c9; size =    139078; name = JS-AD.BMP; optional = true
    file[]: crc = c506e686; size =     19045; name = readme.txt; optional = true
