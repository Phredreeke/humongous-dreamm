desc[he-bluesbirthday]:

name = Blue's Birthday Party
icon = he-bluesbirthday.png
machine = pc
rootpath = D:\
launch = ""
osenv = windows 98
winres = 640x480x8
// test = 1


//
// filesystem
//
mount[]: vpath = C:\hegames; srcpath = $(ifsinstallpath)\hegames
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
        if (!file_exists("C:\\WINDOWS\\hegames.ini")) { file_save("C:\\WINDOWS\\hegames.ini", "$$(INI_CONTENTS)"); }
    ]]]
end

//
// Disc
//
config[disc]:
    condition = is_game()
    title = Disc
    option[cd1]:   name = CD 1 (Yellow); launch = "$(rootpath)\Blue'sBirthday-Yellow.exe"; priority = 1
    option[cd2]: name = CD 2 (Red); launch = "$(rootpath)\Blue'sBirthday-Red.exe"
end

//
// warnings
//
INCOMPATIBLE = true
warning[incompatible]:
    condition = $(INCOMPATIBLE)
    text = Preliminary support
end

