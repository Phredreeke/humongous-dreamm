desc[he-exploreairport]:

name = Let's Explore the Airport
icon = he-exploreairport.png
machine = pc
rootpath = C:\
launch = $(rootpath)\AIRPORT.EXE
osenv = windows 98
winres = 640x480x8
dynamicfile[]: path = C:\WINDOWS\SYSTEM\WING32.DLL; contents = $(NULL)

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// Windows version
//
BITNESS = true
config[bitness]:
    condition = $(BITNESS)
    title = Windows version
    option[win311]:   name = Windows 3.11; osenv= windows 3.11.002
    option[win98]: name = Windows 98; priority = 1
end

//
// warnings
//
INCOMPATIBLE = false
warning[incompatible]:
    condition = $(INCOMPATIBLE)
    text = This version does not run correctly in tested DREAMM version (4.0x16)
end

//
// English version 
//
game[pc-en-950705]:
    name = English 1995-07-05
    anchorfile = AIRPORT.EXE
    file[]: crc = 8fd1b648; size =    120022; name = AIRPORT.BMP; optional = true
    file[]: crc = b8726c07; size =     30720; name = AIRPORT.EXE
    file[]: crc = 18b3bdf9; size =     93231; name = AIRPORT.HE0
    file[]: crc = 0698222a; size = 130591934; name = AIRPORT.HE1
    file[]: crc = cd2eecc3; size =  19243871; name = AIRPORT.HE2
    file[]: crc = c05daad7; size =     36864; name = AIRPORT.HE3
    file[]: crc = 7603da8a; size =  47690651; name = AIRPORT.HE4
    file[]: crc = 67a32468; size =     11485; name = AIRPORT.HE7
    file[]: crc = 0dda5d99; size =     15461; name = AIRPORT.HE9
    file[]: crc = 9309e84e; size =    318830; name = AIRPORT.HLP
    file[]: crc = 0bfde211; size =    294912; name = AIRPORT.W32
    file[]: crc = 2ab99367; size =     40258; name = HE.BMP; optional = true
    file[]: crc = 996e2adf; size =     88816; name = JA-AD.BMP; optional = true
    file[]: crc = 4e987a4c; size =      1240; name = SNDCARDS.INF; optional = true

end

