desc[he-pjslostfound]:

name = Pajama Sam's Lost & Found
icon = he-pjslostfound.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\lost.exe"
osenv = windows 98
audiohw = gmidi
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// Windows version
//
config[bitness]:
    title = Windows version
    option[win311]:   name = Windows 3.11; osenv= windows 3.11.002
    option[win98]: name = Windows 98; priority = 1
end

//
// 1998 version
//
