desc[he-baseball]:

name = Backyard Baseball
icon = he-baseball.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\BASEBALL.EXE"
osenv = windows 98
audiohw = gmidi
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// Windows version
//
config[bitness]:
    title = Windows version
    option[win311]:   name = Windows 3.11; osenv= windows 3.11.002
    option[win98]: name = Windows 98; priority = 1
end

//
// 1997 version
//
game[pc-en-970807]:
    name = English 1997-08-07
    anchorfile = BASEBALL.EXE
    file[]: crc = 7f3c662f; size =    132406; name = BASEBALL.BMP; optional = true
    file[]: crc = a6712191; size =     36352; name = BASEBALL.D32
    file[]: crc = a26710b2; size =      8896; name = BASEBALL.DLL
    file[]: crc = 297d30f5; size =     21616; name = BASEBALL.EXE
