desc[compedia-math1]:

name = Gordi and the Math Invaders
icon = compedia-math1.png
machine = pc
rootpath = D:\
launch = "$(HDDPATH)\Math.exe" /CFG:$(HDDPATH)\Math.ini
osenv = windows 98
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD
mount[]: vpath = $(HDDPATH); srcpath = $(ifsinstallpath)


script[cd-init]:
    code = [[[$(CRLF)
        drive_set_label("D", "$$(CDLABEL)")
        if (!!file_exists("$$(HDDPATH)\\Math.ini")) { file_save("$$(HDDPATH)\\Math.ini", "$$(INI_CONTENTS)") }
    ]]]
end

//
// warnings
//
INCOMPATIBLE = false
warning[incompatible]:
    condition = $(INCOMPATIBLE)
    text = This versiom is not currently playable (4.0x81)
end


