desc[he-bluesart]:

name = Blue's Art Time Activities
icon = he-bluesart.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\ArtTime.exe"
osenv = windows 98
winres = 640x480x16


//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


