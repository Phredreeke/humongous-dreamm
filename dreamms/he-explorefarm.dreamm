desc[he-explorefarm]:

name = Let's Explore the Farm
icon = he-explorefarm.png
machine = pc
rootpath = C:\
launch = $(rootpath)\FARM.EXE
osenv = windows 98
winres = 640x480x8
dynamicfile[]: path = C:\WINDOWS\SYSTEM\WING32.DLL; contents = $(NULL)

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// Windows version
//
BITNESS = true
config[bitness]:
    condition = $(BITNESS)
    title = Windows version
    option[win311]:   name = Windows 3.11; osenv= windows 3.11.002
    option[win98]: name = Windows 98; priority = 1
end

//
// warnings
//
INCOMPATIBLE = false
warning[incompatible]:
    condition = $(INCOMPATIBLE)
    text = This version does not run correctly in tested DREAMM version (4.0x35)
end

//
// English version 
//
game[pc-en-951107]:
    name = English 1995-11-07
    anchorfile = FARM.EXE
    file[]: crc = f4f7a204; size =    122000; name = FARM.BMP; optional = true
