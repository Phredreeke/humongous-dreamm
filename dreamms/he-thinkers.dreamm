desc[he-thinkers]:

name = Big Thinkers! 
icon = he-thinkers.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\THINKER1.EXE"
osenv = windows 98
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// Windows version
//
BITNESS = true
config[bitness]:
    condition = $(BITNESS)
    title = Windows version
    option[win311]:   name = Windows 3.11; osenv= windows 3.11.002
    option[win98]: name = Windows 98; priority = 1
end

//
// 1st Grade
//
game[pc-en-1stgrade-970818]:
    name = 1st Grade English 1997-08-18
    anchorfile = THINKER1.EXE
    file[]: name = BT-AD.BMP; optional = true
    file[]: name = COPYRITE.TXT; optional = true
    file[]: name = HE.BMP; optional = true
    file[]: crc = e2e2de14; size =     14912; name = HEINI.EXE; optional = true
    file[]: name = README.TXT; optional = true
    file[]: crc = af18885f; size =    119780; name = THINKER1.BMP; optional = true
    file[]: crc = a6712191; size =     36352; name = THINKER1.D32
    file[]: crc = a26710b2; size =      8896; name = THINKER1.DLL
