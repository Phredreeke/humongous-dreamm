desc[he-bluestreasurehunt]:

name = Blue's Treasure Hunt
icon = he-bluestreasurehunt.png
machine = pc
rootpath = D:\
launch = "$(rootpath)\Blue'sTreasureHunt-Disc1.w32"
osenv = windows 98
winres = 640x480x16
// test = 1


//
// filesystem
//
mount[]: vpath = C:\hegames; srcpath = $(ifsinstallpath)\hegames
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)



//

//
// Disc
//
BITNESS = true
config[disc]:
    title = Disc
    option[cd1]:   name = CD 1; launch = "D:\Blue'sTreasureHunt-Disc1.w32"; priority = 1
    option[cd2]: name = CD 2; launch = "D:\Blue'sTreasureHunt-Disc2.w32"
end

//
// warnings
//
INCOMPATIBLE = true
warning[incompatible]:
    condition = $(INCOMPATIBLE)
    text = This game is currently not running correctly
end

//
// 1997 version
//
game[pc-en-990729]:
    name = English 1999-07-29
    anchordepth = 1
    anchorfile = Blue'sTreasureHunt-Disc1.exe
