desc[he-fbear]:

name = Fatty Bear's Birthday Surprise
icon = he-fbear.png
machine = pc
rootpath = C:\FBEAR
launch = "$(rootpath)\FBEAR.EXE"
osenv = windows 98
INIPATH = C:\FBEAR\FBEAR.INI
DIGI_DRIVER = $(NULL)
MIDI_DRIVER = $(NULL)
IO = $(NULL)
IRQ = $(NULL)
DIGI_ID = $(NULL)

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


//
// Block ALT key
//
script[init]:
    condition = is_dos() && !is_installer()
    code = [[[$(CRLF)
        // Block ALT key
       keyboard_install_hook(0x38, "remap");
       func remap(){}

       // Save config INI
       file_save("$$(INIPATH)", "$$(INIDATA)");
    ]]]
end




script[autoinstall]:
    condition = is_installer() && is_dos()
    code = [[[$(CRLF)
        if (!prop("noautoinstall")) {
            input_lockout(true);
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
        }
    ]]]
end

config[sound]:
    condition = is_dos()
    title = Sound Configuration
    option[speaker-music]: name = $(SPEAKER_NAME) (Music); MIDI_DRIVER = pcspkr.adv
    option[speaker-voice]: name = $(SPEAKER_NAME) (Speech); DIGI_DRIVER = ibmbak.com; DIGI_ID = 1
    option[adlib-music]:   name = $(ADLIB_NAME) (Music); MIDI_DRIVER = adlib.adv
    option[adlib-voice]:   name = $(ADLIB_NAME) (Speech); DIGI_DRIVER = adlib.com; DIGI_ID = 1
    option[sb16]:          name = $(SB16_NAME); DIGI_DRIVER = sblaster.com; MIDI_DRIVER = sbfm.adv; IO=220; IRQ=7; priority = 1
end

//
// Set up INI file for DOS version
//
INIDATA = [[[$(CRLF)
    DigitalSoundDriver=$(DIGI_DRIVER)
    MidiSoundDriver=$(MIDI_DRIVER)
    IOAddress=$(IO)
    IRQ=$(IRQ)
    DigitalID=$(DIGI_ID)
]]]


//
// 1993 DOS Floppy version
//
game[pc-en-930511-floppy]:
    name = English 1993-05-11 Floppy
    anchorfile = FBEAR.EXE
    osenv = dos
    fixdivover = true
    mips = $(MIPS_386DX_33)
    ramkb = 16384
    audiohw = adlib+sb16
    videohw = svga
    file[]: crc = 56d59cb8; size =      7737; name = CHECK.EXE
    file[]: crc = c62a911f; size =    163752; name = FBEAR.DRV
    file[]: crc = 3e6758ca; size =    139601; name = FBEAR.EXE
    file[]: crc = b94237df; size =      7717; name = FBEAR.HE0
    file[]: crc = 9550b799; size =   6058825; name = FBEAR.HE1
    file[]: crc = 6d77d5b1; size =       766; name = FBEAR.ICO; optional = true
    file[]: crc = b3847dab; size =       545; name = FBEAR.PIF; optional = true
    file[]: crc = 52513973; size =      1115; name = FBEAR.SNG
    file[]: crc = 2195435c; size =   5646444; name = FBEAR.TLK

end

