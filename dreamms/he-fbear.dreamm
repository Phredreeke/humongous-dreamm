desc[he-fbear]:

name = Fatty Bear's Birthday Surprise
icon = he-fbear.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\FBEAR.EXE"
osenv = windows 98
dynamicfile[]: path = C:\WINDOWS\SYSTEM\WING32.DLL; contents = $(NULL)

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


//
// Windows version
//
BITNESS = true
config[bitness]:
    condition = $(BITNESS)
    title = Windows version
    option[win311]:   name = Windows 3.11; osenv= windows 3.11.002
    option[win98]: name = Windows 98; priority = 1
end

//
// Block ALT key
//
script[remap]:
    condition = $(DOSAUDIO)
    code = [[[$(CRLF)
       keyboard_install_hook(0x38, "remap");
       func remap() {  }
    ]]]
end



//
// Set up INI file for DOS version
//
DOSAUDIO = false
dynamicfile[]:
    condition = $(DOSAUDIO)
    path = $(INIPATH)\FBEAR.INI
    contents = [[[$(CRLF)
    DigitalSoundDriver=sblaster.com
    MidiSoundDriver=sbfm.adv
    IOAddress=220
    IRQ=7
    DigitalID=
]]]
end
//

//
// 1993 DOS Floppy version
//
game[pc-en-930511-floppy]:
    name = English 1993-05-11 Floppy
    anchorfile = FBEAR.EXE
    osenv = dos
    fixdivover = true
    mips = $(MIPS_386DX_33)
    ramkb = 16384
    audiohw = adlib+sb16
    videohw = svga
    DOSAUDIO = true
    BITNESS = false
    INIPATH = C:\
    file[]: crc = 56d59cb8; size =      7737; name = CHECK.EXE
    file[]: crc = c62a911f; size =    163752; name = FBEAR.DRV
    file[]: crc = 3e6758ca; size =    139601; name = FBEAR.EXE
    file[]: crc = b94237df; size =      7717; name = FBEAR.HE0
    file[]: crc = 9550b799; size =   6058825; name = FBEAR.HE1
    file[]: crc = 6d77d5b1; size =       766; name = FBEAR.ICO; optional = true
    file[]: crc = b3847dab; size =       545; name = FBEAR.PIF; optional = true
    file[]: crc = 52513973; size =      1115; name = FBEAR.SNG
    file[]: crc = 2195435c; size =   5646444; name = FBEAR.TLK

end

