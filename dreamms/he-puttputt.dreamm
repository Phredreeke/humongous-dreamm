    file[]: crc = 996e2adf; size =     88816; name = JA-AD.BMP; optional = true
    file[]: crc = 2ebf8c76; size =     79202; name = PUTTPUTT.BMP; optional = true
    file[]: crc = e2d65050; size =     30720; name = PUTTPUTT.EXE
    file[]: crc = ece405b0; size =     12728; name = PUTTPUTT.HE0
    file[]: crc = c0fcad18; size =   5046281; name = PUTTPUTT.HE1
    file[]: crc = 0278bc2c; size =  26507681; name = PUTTPUTT.HE2
