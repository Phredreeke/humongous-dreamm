desc[he-puttputt]:

name = Putt-Putt Joins the Parade
icon = he-puttputt.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\PUTTPUTT.EXE"
osenv = windows 98
dynamicfile[]: path = C:\WINDOWS\SYSTEM\WING32.DLL; contents = $(NULL)

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


//
// Windows version
//
BITNESS = true
config[bitness]:
    condition = $(BITNESS)
    title = Windows version
    option[win311]:   name = Windows 3.11; osenv= windows 3.11.002
    option[win98]: name = Windows 98; priority = 1
end

//
// Block ALT key
//
script[remap]:
    condition = $(DOSAUDIO)
    code = [[[$(CRLF)
       keyboard_install_hook(0x38, "remap");
       func remap() {  }
    ]]]
end

//
// Set up INI file for DOS version
//
DOSAUDIO = false
dynamicfile[]:
    condition = $(DOSAUDIO)
    path = $(INIPATH)
    contents = [[[$(CRLF)
    DigitalSoundDriver=sblaster.com
    MidiSoundDriver=sbfm.adv
    IOAddress=220
    IRQ=7
    DigitalID=
]]]
end
//


//
// 1992 DOS version
//
game[pc-en-921119]:
    name = English 1992-11-19
    anchorfile = PUTTPUTT.EXE
    osenv = dos
    fixdivover = true
    mips = $(MIPS_386DX_33)
    ramkb = 16384
    audiohw = adlib+sb16
    videohw = svga
    DOSAUDIO = true
    INIPATH = C:\PUTTPUTT\PUTTPUTT.INI
    BITNESS = false
    file[]: crc = 244b8cc0; size =    111502; name = PUTTPUTT.DRV
    file[]: crc = 38252638; size =    119209; name = PUTTPUTT.EXE
    file[]: crc = cb488496; size =      8107; name = PUTTPUTT.HE0
    file[]: crc = 4a849273; size =   4958821; name = PUTTPUTT.HE1
    file[]: crc = 1793d065; size =       766; name = PUTTPUTT.ICO; optional = true
    file[]: crc = 297e358d; size =       182; name = PUTTPUTT.INI; optional = true
    file[]: crc = 1398c742; size =       545; name = PUTTPUTT.PIF; optional = true
    file[]: crc = d531fc9b; size =  26470756; name = PUTTPUTT.TLK
