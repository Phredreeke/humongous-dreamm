desc[he-puttputt]:

name = Putt-Putt Joins the Parade
icon = he-puttputt.png
machine = pc
rootpath = C:\PUTTPUTT
launch = "$(rootpath)\PUTTPUTT.EXE"
osenv = windows 98
INIPATH = C:\PUTTPUTT\PUTTPUTT.INI
DIGI_DRIVER = $(NULL)
MIDI_DRIVER = $(NULL)
IO = $(NULL)
IRQ = $(NULL)
DIGI_ID = $(NULL)
//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


//
// Block ALT key
//
script[init]:
    condition = is_dos() && !is_installer()
    code = [[[$(CRLF)
        // Block ALT key
       keyboard_install_hook(0x38, "remap");
       func remap(){}

       // Save config INI
       file_save("$$(INIPATH)", "$$(INIDATA)");
    ]]]
end

script[autoinstall]:
    condition = is_installer() && is_dos()
    code = [[[$(CRLF)
        if (!prop("noautoinstall")) {
            input_lockout(true);
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
            wait("int21", 0x07); keyboard_type("\r");
        }
    ]]]
end

config[sound]:
    condition = is_dos()
    title = Sound Configuration
    option[speaker-music]: name = $(SPEAKER_NAME) (Music); MIDI_DRIVER = pcspkr.adv
    option[speaker-voice]: name = $(SPEAKER_NAME) (Speech); DIGI_DRIVER = ibmbak.com; DIGI_ID = 1
    option[adlib-music]:   name = $(ADLIB_NAME) (Music); MIDI_DRIVER = adlib.adv
    option[adlib-voice]:   name = $(ADLIB_NAME) (Speech); DIGI_DRIVER = adlib.com; DIGI_ID = 1
    option[sb16]:          name = $(SB16_NAME); DIGI_DRIVER = sblaster.com; MIDI_DRIVER = sbfm.adv; IO=220; IRQ=7; priority = 1
end

//
// Set up INI file for DOS version
//
INIDATA = [[[$(CRLF)
    DigitalSoundDriver=$(DIGI_DRIVER)
    MidiSoundDriver=$(MIDI_DRIVER)
    IOAddress=$(IO)
    IRQ=$(IRQ)
    DigitalID=$(DIGI_ID)
]]]

//
// 1992 DOS version
//
game[pc-en-921119]:
    name = English 1992-11-19 CD-ROM
    anchorfile = PUTTPUTT.EXE
    osenv = dos
    fixdivover = true
    mips = $(MIPS_386DX_33)
    ramkb = 16384
    audiohw = adlib+sb16
    videohw = svga
    file[]: crc = 244b8cc0; size =    111502; name = PUTTPUTT.DRV
    file[]: crc = 38252638; size =    119209; name = PUTTPUTT.EXE
    file[]: crc = cb488496; size =      8107; name = PUTTPUTT.HE0
    file[]: crc = 4a849273; size =   4958821; name = PUTTPUTT.HE1
    file[]: crc = 1793d065; size =       766; name = PUTTPUTT.ICO; optional = true
