desc[he-freddi4]:

name = Freddi Fish 4: The Case of the Hogfish Rustlers of Briny Gulch
icon = he-freddi4.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\FREDDI4.EXE"
osenv = windows 98
audiohw = gmidi
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// Windows version
//
config[bitness]:
    title = Windows version
    option[win311]:   name = Windows 3.11; osenv= windows 3.11.002
    option[win98]: name = Windows 98; priority = 1
end

