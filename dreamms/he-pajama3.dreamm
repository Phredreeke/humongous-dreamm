desc[he-pajama3]:

name = Pajama Sam 3: You Are What You Eat From Your Head to Your Feet
icon = he-pajama3.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\Pajama3.exe"
osenv = windows 98
audiohw = gmidi
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// Windows version
//
config[bitness]:
    title = Windows version
    option[win311]:   name = Windows 3.11; osenv= windows 3.11.002
    option[win98]: name = Windows 98; priority = 1
end


//
// 2000 version
//
game[pc-en-000202]:
    name = English 2000-02-02
    anchorfile = Pajama3.exe
    launch = "$(rootpath)\Pajama3.w32"
