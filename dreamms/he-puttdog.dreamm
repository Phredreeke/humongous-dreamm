desc[he-puttdog]:

name = Putt-Putt and Pep's Dog on a Stick
icon = he-puttdog.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\DOG.EXE"
osenv = windows 98
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// Windows version
//
BITNESS = true
config[bitness]:
    condition = $(BITNESS)
    title = Windows version
    option[win311]:   name = Windows 3.11; osenv= windows 3.11.002
    option[win98]: name = Windows 98; priority = 1
end

//
// 1996 version
//
game[pc-en-960822]:
    name = English 1996-08-22
    anchorfile = DOG.EXE
    file[]: crc = a6670f92; size =    132404; name = DOG.BMP; optional = true
    file[]: crc = a26710b2; size =      8896; name = DOG.DLL
    file[]: crc = bc2f01df; size =     21648; name = DOG.EXE
