    file[]: crc = 761b55c1; size =     11192; name = README.TXT; optional = true



end

//
// 1999 version (Super Arcade 2)
//
game[pc-en-990723]:
    name = English 1999-07-23 (Super Arcade 2)
    imports = pc-en-960822
    anchorfile = DOG.EXE
    file[]: crc = 6e78e04b; size =       681; name = COPYRITE.TXT; optional = true  // new file
    file[]: crc = cb1d364f; size =    322560; name = dog.a32  // new file
    file[]: crc = fb74cc42; size =    244224; name = dog.exe  // replaces bc2f01df/21648
    file[]: crc = e0730f25; size =       766; name = DOG.ICO; optional = true  // new file
    file[]: crc = f36badf1; size =      2067; name = dog.inf; optional = true  // replaces e54535d1/2069
    file[]: remove = DOG.BMP
    file[]: remove = DOG.W32
    file[]: remove = HE.BMP
    file[]: remove = HEINI.EXE
    file[]: remove = JA-AD.BMP



end


