desc[he-pjsgames]:

name = Pajama Sam: Games to Play on Any Day
icon = he-pjsgames.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\PJGAMES.EXE"
osenv = windows 98
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


//
// 2001 version
//
game[pc-en-010518]:
    name = English 2001-05-18
    anchorfile = PJGAMES.EXE
    file[]: crc = 3dde6a77; size =       971; name = Copyright.txt; optional = true
    file[]: crc = 8d845bd1; size =      5752; name = license.txt; optional = true
    file[]: crc = c5128684; size =    346624; name = mss32.dll
