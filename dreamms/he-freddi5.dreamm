desc[he-freddi5]:

name = Freddi Fish 5: The Case of the Creature of Coral Cave
icon = he-freddi5.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\freddicove.EXE"
osenv = windows 98
audiohw = gmidi
winres = 640x480x16

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// warnings
//
warning[unsupported]:
    text = This game does not run correctly in tested DREAMM version (4.0x11)
end

//
// Color depth
//
config[bitness]:
    title = Color depth
    option[8bitcolor]:   name = 8-bit; winres = 640x480x8
    option[16bitcolor]: name = 16-bit; priority = 1
end

