desc[he-freddi5]:

name = Freddi Fish 5: The Case of the Creature of Coral Cave
icon = he-freddi5.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\freddicove.EXE"
osenv = windows 98
winres = 640x480x16

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

