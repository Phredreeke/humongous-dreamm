desc[he-puttballoon]:

name = Putt-Putt and Pep's Balloon-O-Rama
icon = he-puttballoon.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\BALLOON.EXE"
osenv = windows 98
audiohw = gmidi
winres = 640x480x8


//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// Windows version
//
config[bitness]:
    title = Windows version
    option[win311]:   name = Windows 3.11; osenv= windows 3.11.002
    option[win98]: name = Windows 98; priority = 1
end

