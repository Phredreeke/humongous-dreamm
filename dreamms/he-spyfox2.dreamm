desc[he-spyfox2]:

name = SPY Fox 2: Some Assembly Required
icon = he-spyfox2.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\Spyfox2.exe"
osenv = windows 98
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


//
// 1999 version
//
game[pc-en-990805]:
    name = English 1999-08-05
    anchorfile = Spyfox2.exe
    launch = "$(rootpath)\Spyfox2.w32"
