desc[he-spyfox2]:

name = SPY Fox 2: Some Assembly Required
icon = he-spyfox2.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\Spyfox2.exe"
osenv = windows 98
audiohw = gmidi
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// Windows version
//
config[bitness]:
    title = Windows version
    option[win311]:   name = Windows 3.11; osenv= windows 3.11.002
    option[win98]: name = Windows 98; priority = 1
end

//
// 1999 version
//
game[pc-en-990805]:
    name = English 1999-08-05
    anchorfile = Spyfox2.exe
    launch = "$(rootpath)\Spyfox2.w32"
    file[]: crc = abb96326; size =    308278; name = HE.BMP; optional = true
