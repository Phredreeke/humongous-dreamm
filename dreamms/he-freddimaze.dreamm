desc[he-freddimaze]:

name = Freddi Fish and Luther's Maze Madness
icon = he-freddimaze.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\MAZE.EXE"
osenv = windows 98
audiohw = gmidi
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// Windows version
//
BITNESS = true
config[bitness]:
    condition = $(BITNESS)
    title = Windows version
    option[win311]:   name = Windows 3.11; osenv= windows 3.11.002
    option[win98]: name = Windows 98; priority = 1
end

//
// 1996 version
//
game[pc-en-961126]:
    name = English 1996-11-26
    anchorfile = MAZE.EXE
    file[]: crc = 0106d4d8; size =     97100; name = HE.BMP; optional = true
    file[]: crc = 5cab4539; size =     14912; name = HEINI.EXE; optional = true
    file[]: crc = 77892d97; size =    139078; name = JA-AD.BMP; optional = true
    file[]: crc = b827aa76; size =    132406; name = MAZE.BMP; optional = true
    file[]: crc = a26710b2; size =      8896; name = MAZE.DLL
    file[]: crc = 57b089f1; size =     21648; name = MAZE.EXE
    file[]: crc = 367f943a; size =     23479; name = MAZE.HE0
    file[]: crc = f75ac48c; size =  11783273; name = MAZE.HE1
    file[]: crc = 00b7a5cb; size =   7275888; name = MAZE.HE2
    file[]: crc = c9365702; size =  21498460; name = MAZE.HE4
    file[]: crc = 3d714df4; size =    211800; name = MAZE.HE8
    file[]: crc = 4433c0f8; size =    126300; name = MAZE.HLP; optional = true
    file[]: crc = de18a0a5; size =      2080; name = MAZE.INF; optional = true
    file[]: crc = 19d81924; size =    324096; name = MAZE.W32
    file[]: crc = b030850a; size =     10880; name = README.TXT; optional = true

end

//
// 1999 version (Super Arcade 2)
//
game[pc-en-990824]:
    name = English 1999-08-24 (Super Arcade 2)
    anchorfile = MAZE.EXE
    imports = pc-en-961126
    file[]: crc = 6e78e04b; size =       681; name = COPYRITE.TXT  // new file
    file[]: crc = 19d81924; size =    324096; name = maze.a32  // new file
    file[]: crc = f91190c2; size =    244224; name = MAZE.EXE  // replaces 57b089f1/21648
    file[]: crc = ad4744ab; size =      2067; name = maze.inf  // replaces de18a0a5/2080
    file[]: remove = HE.BMP
    file[]: remove = HEINI.EXE
    file[]: remove = JA-AD.BMP
    file[]: remove = MAZE.BMP
    file[]: remove = MAZE.W32

end

