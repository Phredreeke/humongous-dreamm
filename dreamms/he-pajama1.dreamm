desc[he-pajama1]:

name = Pajama Sam 1: No Need to Hide When It's Dark Outside
icon = he-pajama1.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\PAJAMA.EXE"
osenv = windows 98
audiohw = gmidi
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


//
// Windows version
//
BITNESS = true
config[bitness]:
    condition = $(BITNESS)
    title = Windows version
    option[win311]:   name = Windows 3.11; osenv= windows 3.11.002
    option[win98]: name = Windows 98; priority = 1
end

//
// Color depth
//
COLORDEPTH = false
config[colordepth]:
    condition = $(COLORDEPTH)
    title = Color depth
    option[8bitcolor]:   name = 8-bit; winres = 640x480x8
    option[16bitcolor]: name = 16-bit; winres = 640x480x16; priority = 1
end

//
// warnings
//
INCOMPATIBLE = false
warning[incompatible]:
    condition = $(INCOMPATIBLE)
    text = This version does not run correctly in tested DREAMM version (4.0x12)
end


//
// 1996 version
//
game[pc-en-960909]:
    name = English 1996-09-09
    anchorfile = PAJAMA.EXE
    file[]: crc = a99ece0e; size =     97070; name = HE.BMP; optional = true
