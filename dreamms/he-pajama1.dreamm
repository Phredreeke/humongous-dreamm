desc[he-pajama1]:

name = Pajama Sam 1: No Need to Hide When It's Dark Outside
icon = he-pajama1.png
machine = pc
rootpath = C:\
launch = "$(rootpath)\PAJAMA.EXE"
osenv = windows 98
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)


//
// Windows version
//
BITNESS = true
config[bitness]:
    condition = $(BITNESS)
    title = Windows version
    option[win311]:   name = Windows 3.11; osenv= windows 3.11.002
    option[win98]: name = Windows 98; priority = 1
end


