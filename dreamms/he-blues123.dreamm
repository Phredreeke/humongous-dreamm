desc[he-blues123]:

name = Blue's 123 Time Activities
icon = he-blues123.png
machine = pc
rootpath = D:\
launch = $(rootpath)\Blues123Time.a32
osenv = windows 98
winres = 640x480x16

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = C:\hegames; srcpath = $(ifsinstallpath)\hegames

//
// English version 
//
